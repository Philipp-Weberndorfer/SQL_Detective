# Kopiere diese Datei zu .env und passe die Werte an.
# .env steht in .gitignore und darf niemals committet werden.

# --- Anwendungsdatenbank (Benutzer, Fortschritt, Faelle) ---
APP_DB_NAME=sqldetective_app
APP_DB_USER=sqld
APP_DB_PASSWORD=dev

# --- Spieldatenbank (Falldaten, auf die Spieler-SQL zugreift) ---
GAME_DB_NAME=sqldetective_game
GAME_DB_USER=sqld
GAME_DB_PASSWORD=dev

# Nur-Lese-Benutzer: ueber diesen laufen ALLE Spielerabfragen.
# Wird von db/game/03_readonly_user.sh verwendet.
GAME_DB_READONLY_USER=game_readonly
GAME_DB_READONLY_PASSWORD=readonly_dev

# --- Backend ---
BACKEND_PORT=8080
JWT_SECRET=bitte-aendern

# Sicherheitsgrenzen fuer Spielerabfragen (F34, F35, F113, F114)
QUERY_TIMEOUT_MS=5000
QUERY_MAX_ROWS=500

# --- KI-Detektiv ---
# Schluessel NUR hier lokal eintragen, nie ins Repository.
LLM_API_KEY=
LLM_MODEL=
