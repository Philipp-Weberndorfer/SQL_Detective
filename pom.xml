<?xml version="1.0" encoding="UTF-8"?>
<!--
  Sammel-POM der Repository-Wurzel.

  Baut selbst nichts, sondern fasst die Java-Module zusammen. Dadurch erkennt
  jede IDE beim Oeffnen des Projektordners sofort die Struktur, und ein
  "mvn test" in der Wurzel testet alle Module auf einmal.

  Frontend (TypeScript) und MCP-Server haben ihre eigenen Build-Werkzeuge und
  stehen bewusst nicht hier drin.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>at.htlwels</groupId>
    <artifactId>sql-detective</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>SQL Detective</name>
    <description>Lernspiel fuer SQL mit Kriminalfaellen und KI-Detektiv</description>

    <modules>
        <module>backend</module>
    </modules>

</project>
